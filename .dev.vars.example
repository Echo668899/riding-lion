# Copy to .dev.vars for local wrangler dev (never commit .dev.vars)

# Required: HMAC secret for signed media URLs served to fal / browsers
MEDIA_SIGNING_SECRET=dev-change-me-to-a-long-random-string

# Optional public base URL (defaults to incoming request host)
# APP_BASE_URL=http://127.0.0.1:8787

# fal.ai Seedance 2.5 US editing — required for real generation
# FAL_KEY=fal_xxxxxxxx
# With FAL_KEY set, leave MOCK_GENERATION=false (or omit) to call fal.
# Template + portrait are uploaded to fal CDN before submit (works on localhost).
# MOCK_GENERATION=false

# Resend — send + receive via support@ridinglion.com
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Riding Lion <support@ridinglion.com>
# Optional shared secret for /api/webhooks/resend (?secret= or header)
# RESEND_WEBHOOK_SECRET=dev-resend-webhook-secret

# Override vars if needed:
# ASSET_RETENTION_DAYS=7
# SIGNED_URL_TTL_SECONDS=7200
