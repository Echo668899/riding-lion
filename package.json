{
  "name": "riding-lion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite build --watch",
    "build": "npm run build:client && wrangler deploy --dry-run",
    "build:client": "vite build",
    "deploy": "npm run build:client && wrangler deploy",
    "db:bootstrap": "bash scripts/bootstrap-cf.sh",
    "seed:assets:remote": "bash scripts/seed-remote-assets.sh",
    "db:migrate:local": "wrangler d1 migrations apply riding-lion --local",
    "db:migrate:remote": "wrangler d1 migrations apply riding-lion --remote",
    "seed:assets:local": "bash scripts/seed-local-assets.sh",
    "accept:smoke": "bash scripts/accept-smoke.sh",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.162.0"
  }
}
